{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npx esbuild server.ts --platform=node --packages=external --bundle --format=esm --outfile=server.js && npx esbuild api/login.ts --platform=node --packages=external --bundle --format=esm --outfile=api/login.js && npx esbuild api/users.ts --platform=node --packages=external --bundle --format=esm --outfile=api/users.js",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "dxf-parser": "^1.1.2",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "^1.9.4",
    "libredwg": "^0.0.0-dev.0",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.11.2",
    "motion": "^12.23.24",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.1",
